@model List<GetCategoriesQueryResult>

@{
    ViewData["Title"] = "Kategoriler";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Kategoriler</h2>
    <a asp-action="CreateCategory" class="btn btn-primary">Yeni Kategori</a>
</div>

@* Silme başarısız olursa controller'dan gelen mesaj *@
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<table class="table table-bordered table-hover">
    <thead class="table-light">
        <tr>
            <th>#</th>
            <th>Kategori Adı</th>
            <th style="width: 180px">İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>
                    <a asp-action="UpdateCategory" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Güncelle</a>
                    <a asp-action="DeleteCategory" asp-route-id="@item.Id" class="btn btn-sm btn-danger"
                       onclick="return confirm('Bu kategoriyi silmek istediğinize emin misiniz?')">Sil</a>
                </td>
            </tr>
        }
    </tbody>
</table>