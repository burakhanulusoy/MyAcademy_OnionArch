@model UpdateCategoryCommand

@{
    ViewData["Title"] = "Kategori Güncelle";
}

<h2>Kategori Güncelle</h2>

<form asp-action="UpdateCategory" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    @* Id kullanıcıya görünmez ama formla birlikte gönderilir *@
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="Name" class="form-label">Kategori Adı</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Güncelle</button>
    <a asp-action="Index" class="btn btn-secondary">Geri</a>
</form>