@model CreateCategoryCommand

@{
    ViewData["Title"] = "Yeni Kategori";
}

<h2>Yeni Kategori</h2>

<form asp-action="CreateCategory" method="post">
    @* Alana ait olmayan genel hatalar (PropertyName boş olanlar) burada görünür *@
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label">Kategori Adı</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Kaydet</button>
    <a asp-action="Index" class="btn btn-secondary">Geri</a>
</form>